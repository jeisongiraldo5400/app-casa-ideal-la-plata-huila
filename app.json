{
  "expo": {
    "name": "Casa Ideal",
    "slug": "app-casa-ideal",
    "version": "2.0.1",
    "orientation": "default",
    "scheme": "appcasaideal",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icono.png",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icono.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff",
      "imageWidth": 200
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.casaideal.laplatahuila",
      "icon": "./assets/images/icono.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Permitir acceso a la cámara para escanear códigos de barras y capturar soportes de pago.",
        "NSPhotoLibraryUsageDescription": "Permitir acceso a la galería para adjuntar soportes de pago.",
        "NSFaceIDUsageDescription": "Usamos Face ID para proteger la cartera y los datos de clientes en este dispositivo.",
        "NSBluetoothAlwaysUsageDescription": "Usamos Bluetooth para conectar la impresora térmica e imprimir recibos de pago y tickets de negocio.",
        "NSBluetoothPeripheralUsageDescription": "Usamos Bluetooth para conectar la impresora térmica e imprimir recibos de pago y tickets de negocio."
      }
    },
    "android": {
      "icon": "./assets/images/icono.png",
      "adaptiveIcon": {
        "backgroundColor": "#1e3a8a",
        "foregroundImage": "./assets/images/icono.png"
      },
      "splash": {
        "image": "./assets/images/icono.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff",
        "imageWidth": 200
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.casaideal.laplatahuila"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icono.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icono.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "imageWidth": 200
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir acceso a la cámara para escanear códigos de barras."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Permitir acceso a la cámara para capturar soportes de pago.",
          "photosPermission": "Permitir acceso a la galería para adjuntar soportes de pago."
        }
      ],
      "expo-local-authentication",
      [
        "@morrowdigital/watermelondb-expo-plugin",
        {
          "disableJsi": false
        }
      ],
      "./plugins/withWatermelonJsiCmakePath",
      "./plugins/withAndroidBluetoothPrinterPermissions",
      [
        "react-native-thermal-printer-driver",
        {
          "bluetoothAlwaysUsageDescription": "Usamos Bluetooth para conectar la impresora térmica e imprimir recibos de pago y tickets de negocio.",
          "bluetoothPeripheralUsageDescription": "Usamos Bluetooth para conectar la impresora térmica e imprimir recibos de pago y tickets de negocio."
        }
      ],
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e4ea88b1-ecc0-4487-897f-d28f2f7eb407"
      }
    }
  }
}
